{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": false,
  "labels": ["dependencies"],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "osvVulnerabilityAlerts": true,
  "enabledManagers": ["custom.regex", "github-actions", "gomod"],
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Go toolchain pinned in the Makefile and Dockerfile",
      "managerFilePatterns": ["/^Makefile$/", "/^Dockerfile$/"],
      "matchStrings": [
        "GO_VERSION\\s*\\??=\\s*(?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)"
      ],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "golangci-lint pinned in the Makefile and Dockerfile",
      "managerFilePatterns": ["/^Makefile$/", "/^Dockerfile$/"],
      "matchStrings": [
        "GOLANGCI_LINT_VERSION\\s*\\??=\\s*(?<currentValue>v?\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "golangci/golangci-lint",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "buf pinned in the Makefile and Dockerfile",
      "managerFilePatterns": ["/^Makefile$/", "/^Dockerfile$/"],
      "matchStrings": [
        "BUF_VERSION\\s*\\??=\\s*(?<currentValue>v?\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "bufbuild/buf",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "mockery pinned in the Dockerfile",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "github\\.com/vektra/mockery/v2@(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "github.com/vektra/mockery/v2",
      "datasourceTemplate": "go"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["go", "golang"],
      "separateMinorPatch": true
    },
    {
      "matchPackageNames": ["go", "golang"],
      "matchUpdateTypes": ["patch"],
      "groupName": "go patch version"
    },
    {
      "matchPackageNames": ["go", "golang"],
      "matchUpdateTypes": ["minor"],
      "groupName": "go minor version"
    },
    {
      "matchPackageNames": [
        "golangci/golangci-lint",
        "bufbuild/buf",
        "github.com/vektra/mockery/v2"
      ],
      "groupName": "dev tools"
    },
    {
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor"],
      "groupName": "Minor Go modules"
    },
    {
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["patch"],
      "groupName": "Patch Go modules"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "GitHub Actions"
    }
  ]
}
